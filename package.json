{
  "name": "PrismGit",
  "productName": "PrismGit",
  "version": "2.0.0",
  "description": "A modern Git client built on Electron + React + TypeScript — visual history, smart merges, and a clean Ayu palette.",
  "author": "PrismGit Team",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "package": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac",
    "package:mac-arm": "npm run build && electron-builder --mac --arm64",
    "package:mac-x64": "npm run build && electron-builder --mac --x64",
    "package:linux": "npm run build && electron-builder --linux",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit tests/components",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test --workers=1",
    "test:e2e:headed": "xvfb-run -a playwright test --workers=1",
    "test:verify": "npm run typecheck && npm run test && npm run build && npm run test:e2e",
    "verify": "npm run typecheck && npm run test && npm run build",
    "audit:contrast": "node scripts/audit-contrast.mjs",
    "hooks:install": "bash scripts/install-hooks.sh",
    "icons": "python3 scripts/make-icons.py",
    "test:simple-git": "node --test tests/simple-git-suite.mjs",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:check": "cd src-tauri && cargo check"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-shell": "^2.3.6",
    "chokidar": "^3.6.0",
    "clsx": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "simple-git": "^3.27.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "@vitest/coverage-v8": "^2.1.2",
    "@vitest/ui": "^2.1.2",
    "autoprefixer": "^10.4.20",
    "electron": "^32.1.2",
    "electron-builder": "^25.1.8",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.9.3",
    "vite": "^5.4.8",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^2.1.2"
  },
  "build": {
    "appId": "com.prismgit.electron",
    "productName": "PrismGit",
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "build/icon-512.png",
        "to": "icon-512.png"
      },
      {
        "from": "build/logo-256.png",
        "to": "logo-256.png"
      }
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/chokidar/**/*",
      "node_modules/anymatch/**/*",
      "node_modules/braces/**/*",
      "node_modules/glob-parent/**/*",
      "node_modules/is-binary-path/**/*",
      "node_modules/is-glob/**/*",
      "node_modules/normalize-path/**/*",
      "node_modules/path-is-absolute/**/*",
      "node_modules/readdirp/**/*",
      "node_modules/micromatch/**/*",
      "node_modules/picomatch/**/*",
      "node_modules/fill-range/**/*",
      "node_modules/to-regex-range/**/*",
      "node_modules/binary-extensions/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "category": "Development",
      "icon": "build/icons",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
