{
  "name": "PrismGit",
  "productName": "PrismGit",
  "version": "2.2.0",
  "description": "A modern Git client built on Electron + React + TypeScript — visual history, smart merges, and a clean Ayu palette.",
  "author": "Mirocow <mr.mirocow@gmail.com>",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "desktopName": "PrismGit",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "package": "npm run build && node scripts/run-pkg.mjs",
    "package:win": "npm run build && node scripts/run-pkg.mjs --win",
    "package:win:zip": "npm run build && node scripts/run-pkg.mjs --win zip",
    "package:mac": "npm run build && node scripts/run-pkg.mjs --mac",
    "package:mac-arm": "npm run build && node scripts/run-pkg.mjs --mac --arm64",
    "package:mac-x64": "npm run build && node scripts/run-pkg.mjs --mac --x64",
    "package:linux": "npm run build && node scripts/run-pkg.mjs --linux",
    "pkg:check": "node scripts/run-pkg.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit tests/components",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test --workers=1",
    "test:e2e:headed": "xvfb-run -a playwright test --workers=1",
    "test:verify": "npm run typecheck && npm run test:simple-git && npm run test && npm run build && npm run test:e2e",
    "verify": "npm run typecheck && npm run test:simple-git && npm run test && npm run build",
    "audit:contrast": "node scripts/audit-contrast.mjs",
    "hooks:install": "bash scripts/install-hooks.sh",
    "icons": "python3 scripts/make-icons.py",
    "test:simple-git": "node --test tests/simple-git-suite.mjs",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:check": "cd src-tauri && cargo check"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "@tauri-apps/plugin-fs": "^2.6.0",
    "@tauri-apps/plugin-shell": "^2.4.0",
    "clsx": "^2.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "simple-git": "^4.0.2",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^2.12.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "@vitest/ui": "^5.0.2",
    "autoprefixer": "^10.6.1",
    "chokidar": "^5.0.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^5.0.2"
  },
  "build": {
    "appId": "com.prismgit.electron",
    "productName": "PrismGit",
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "build/icon-512.png",
        "to": "icon-512.png"
      },
      {
        "from": "build/logo-256.png",
        "to": "logo-256.png"
      }
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "category": "Development",
      "icon": "build/icons",
      "syncDesktopName": true,
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "homepage": "http://178.140.10.58:8082/web/git/prismgit"
}
