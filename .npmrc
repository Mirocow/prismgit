# PrismGit project npm config.
# Only download-mirror keys are set — the registry itself is NOT overridden,
# whatever your machine/user config uses keeps working.

# Electron binary mirror for the `electron` npm package postinstall and
# electron-builder. npmmirror is a public CDN that mirrors every Electron
# release — fast in RU/CIS and works where github.com is throttled/blocked.
# Per-machine override (wins over this file): export ELECTRON_MIRROR=<url>
electron_mirror=https://npmmirror.com/mirrors/electron/

# electron-builder tooling (nsis, appimage, fpm, 7zip…) mirror.
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/
